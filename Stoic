<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stoic Clothing</title>
    <style>
        /* General Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        /* Header */
        header {
            background: #000;
            color: #fff;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 1.5rem;
            font-weight: bold;
        }

        nav ul {
            display: flex;
            gap: 1rem;
        }

        nav ul li {
            font-size: 1rem;
        }

        nav ul li a:hover {
            color: #f4a261;
        }

        /* Hero Section */
        .hero {
            background: url('https://via.placeholder.com/1200x600') no-repeat center center/cover;
            height: 60vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: #fff;
        }

        .hero h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .hero button {
            padding: 0.8rem 2rem;
            font-size: 1rem;
            border: none;
            background: #f4a261;
            color: #fff;
            cursor: pointer;
            border-radius: 5px;
            transition: background 0.3s ease;
        }

        .hero button:hover {
            background: #e76f51;
        }

        /* Featured Products */
        .products {
            padding: 2rem;
            text-align: center;
        }

        .products h2 {
            font-size: 2rem;
            margin-bottom: 1.5rem;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .product-card {
            border: 1px solid #ddd;
            border-radius: 5px;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .product-card h3 {
            font-size: 1.2rem;
            margin: 0.5rem 0;
        }

        .product-card p {
            font-size: 0.9rem;
            color: #666;
        }

        /* About Section */
        .about {
            padding: 2rem;
            background: #f9f9f9;
            text-align: center;
        }

        .about h2 {
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .about p {
            font-size: 1rem;
            max-width: 600px;
            margin: 0 auto;
            color: #555;
        }

        /* Contact Section */
        .contact {
            padding: 2rem;
            text-align: center;
        }

        .contact h2 {
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .contact form {
            max-width: 400px;
            margin: 0 auto;
        }

        .contact form input,
        .contact form textarea,
        .contact form button {
            width: 100%;
            padding: 0.8rem;
            margin: 0.5rem 0;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        .contact form button {
            background: #f4a261;
            color: #fff;
            border: none;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        .contact form button:hover {
            background: #e76f51;
        }

        /* Footer */
        footer {
            background: #000;
            color: #fff;
            text-align: center;
            padding: 1rem;
            margin-top: 2rem;
        }

        footer p {
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <h1>Stoic</h1>
        <nav>
            <ul>
                <li><a href="#products">Products</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div>
            <h2>Embrace the Minimalist Lifestyle</h2>
            <button>Shop Now</button>
        </div>
    </section>

    <!-- Featured Products -->
    <section id="products" class="products">
        <h2>Featured Products</h2>
        <div class="product-grid">
            <div class="product-card">
                <img src="https://via.placeholder.com/250" alt="Product 1">
                <h3>Classic Tee</h3>
                <p>$25.00</p>
            </div>
            <div class="product-card">
                <img src="https://via.placeholder.com/250" alt="Product 2">
                <h3>Minimalist Hoodie</h3>
                <p>$45.00</p>
            </div>
            <div class="product-card">
                <img src="https://via.placeholder.com/250" alt="Product 3">
                <h3>Relaxed Fit Pants</h3>
                <p>$35.00</p>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <h2>About Stoic</h2>
        <p>At Stoic, we believe in simplicity, quality, and timeless design. Our clothing is designed to inspire confidence and embrace a minimalist lifestyle.</p>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <h2>Contact Us</h2>
        <form>
            <input type="text" placeholder="Your Name" required>
            <input type="email" placeholder="Your Email" required>
            <textarea rows="5" placeholder="Your Message" required></textarea>
            <button type="submit">Send Message</button>
        </form>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2023 Stoic Clothing. All rights reserved.</p>
    </footer>
</body>
</html>
